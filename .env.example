# Required for live WF1/WF2 text extraction and WF3 receipt extraction.
GROQ_API_KEY=replace-with-your-key

# Optional: cross-family Gemini judge for open-text evaluation.
GOOGLE_API_KEY=

# Safe public-repository default. Set this to "google" only after completing the optional
# dedicated-project-account setup in docs/google_calendar_setup.md.
CALENDAR_BACKEND=mock
GOOGLE_TOKEN_PATH=secrets/google_token.json
GOOGLE_CLIENT_SECRET_PATH=secrets/client_secret.json
GOOGLE_CALENDARS_PATH=secrets/google_calendars.json

# Persistent local synthetic workspace. Use :memory: for an ephemeral session.
RECORD_STORE_PATH=data/workspace.db
